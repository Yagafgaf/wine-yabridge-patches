From 76761014c098a034fa5eebeb9384a12027a453be Mon Sep 17 00:00:00 2001
From: Yagafgaf <Yagafgaf@users.noreply.github.com>
Date: Thu, 29 Oct 2026 16:13:21 +0300
Subject: [PATCH 07/10] dwrite: share FreeType faces among font objects with
 the same data, keep idle ones cached

---
 dlls/dwrite/freetype.c | 155 ++++++++++++++++++++++++++++++++++++++---
 1 file changed, 145 insertions(+), 10 deletions(-)

diff --git a/dlls/dwrite/freetype.c b/dlls/dwrite/freetype.c
index 10d5681..0e554b8 100644
--- a/dlls/dwrite/freetype.c
+++ b/dlls/dwrite/freetype.c
@@ -27,6 +27,8 @@
 #include <sys/types.h>
 #include <dlfcn.h>
 #include <stdlib.h>
+#include <string.h>
+#include <pthread.h>
 
 #ifdef HAVE_FT2BUILD_H
 #include <ft2build.h>
@@ -43,6 +45,7 @@
 #include "unixlib.h"
 
 #include "dwrite_private.h"
+#include "wine/list.h"
 
 #ifdef SONAME_LIBFREETYPE
 
@@ -243,32 +246,145 @@ static NTSTATUS process_detach(void *args)
     return STATUS_SUCCESS;
 }
 
-static NTSTATUS create_font_object(void *args)
+/* FreeType faces are shared by all font objects with the same data.
+ * Applications (plugin editors) can create the same font face hundreds of
+ * times, and a new FT_Face redoes table parsing and autohinter setup each
+ * time. A cached face owns a copy of the font data, so it can outlive the
+ * caller's buffer; up to FACE_CACHE_IDLE_MAX unused faces are kept.
+ * Since font objects of different IDWriteFontFace instances may share a face,
+ * all entry points that use faces are serialized by freetype_mutex. */
+#define FACE_CACHE_IDLE_MAX 16
+
+struct cached_face
+{
+    struct list entry;
+    FT_Face face;
+    void *data;
+    UINT64 size;
+    UINT32 index;
+    UINT64 hash;
+    LONG refcount;
+};
+
+static struct list cached_faces = LIST_INIT(cached_faces);
+static unsigned int idle_cached_faces;
+static pthread_mutex_t freetype_mutex = PTHREAD_MUTEX_INITIALIZER;
+
+/* Cheap key: the size, the first 4 KiB (table directory) and 64 words spread
+ * over the file. Candidates are then compared in full with memcmp(). */
+static UINT64 hash_font_data(const BYTE *data, UINT64 size)
+{
+    UINT64 hash = 0xcbf29ce484222325ull ^ size, chunk, head = min(size, 4096), i;
+
+    for (i = 0; i + 8 <= head; i += 8)
+    {
+        memcpy(&chunk, data + i, 8);
+        hash = (hash ^ chunk) * 0x100000001b3ull;
+    }
+    if (size >= 8)
+    {
+        for (i = 0; i < 64; ++i)
+        {
+            memcpy(&chunk, data + (size - 8) * i / 63, 8);
+            hash = (hash ^ chunk) * 0x100000001b3ull;
+        }
+    }
+    return hash ^ (hash >> 29);
+}
+
+static void destroy_cached_face(struct cached_face *cached)
+{
+    list_remove(&cached->entry);
+    pFT_Done_Face(cached->face);
+    free(cached->data);
+    free(cached);
+}
+
+static NTSTATUS create_font_object_unlocked(void *args)
 {
     struct create_font_object_params *params = args;
+    struct cached_face *cached;
     FT_Face face = NULL;
     FT_Error fterror;
+    UINT64 hash;
+
+    hash = hash_font_data(params->data, params->size);
+    LIST_FOR_EACH_ENTRY(cached, &cached_faces, struct cached_face, entry)
+    {
+        if (cached->hash == hash && cached->size == params->size && cached->index == params->index
+                && !memcmp(cached->data, params->data, params->size))
+        {
+            if (!cached->refcount++)
+                --idle_cached_faces;
+            list_remove(&cached->entry);
+            list_add_head(&cached_faces, &cached->entry);
+            *params->object = (ULONG_PTR)cached->face;
+            return STATUS_SUCCESS;
+        }
+    }
 
-    fterror = pFT_New_Memory_Face(library, params->data, params->size, params->index, &face);
+    if (!(cached = calloc(1, sizeof(*cached))) || !(cached->data = malloc(params->size)))
+    {
+        free(cached);
+        return STATUS_NO_MEMORY;
+    }
+    memcpy(cached->data, params->data, params->size);
+
+    fterror = pFT_New_Memory_Face(library, cached->data, params->size, params->index, &face);
     if (fterror != FT_Err_Ok)
     {
         WARN("Failed to create a face object, error %d.\n", fterror);
+        free(cached->data);
+        free(cached);
         return STATUS_UNSUCCESSFUL;
     }
 
+    cached->face = face;
+    cached->size = params->size;
+    cached->index = params->index;
+    cached->hash = hash;
+    cached->refcount = 1;
+    list_add_head(&cached_faces, &cached->entry);
+
     *params->object = (ULONG_PTR)face;
 
     return STATUS_SUCCESS;
 }
 
-static NTSTATUS release_font_object(void *args)
+static NTSTATUS release_font_object_unlocked(void *args)
 {
     struct release_font_object_params *params = args;
-    pFT_Done_Face(FaceFromObject(params->object));
+    FT_Face face = FaceFromObject(params->object);
+    struct cached_face *cached, *next;
+
+    LIST_FOR_EACH_ENTRY(cached, &cached_faces, struct cached_face, entry)
+    {
+        if (cached->face != face)
+            continue;
+
+        if (!--cached->refcount)
+        {
+            ++idle_cached_faces;
+            /* Drop the least recently used idle faces. */
+            LIST_FOR_EACH_ENTRY_SAFE_REV(cached, next, &cached_faces, struct cached_face, entry)
+            {
+                if (idle_cached_faces <= FACE_CACHE_IDLE_MAX)
+                    break;
+                if (!cached->refcount)
+                {
+                    destroy_cached_face(cached);
+                    --idle_cached_faces;
+                }
+            }
+        }
+        return STATUS_SUCCESS;
+    }
+
+    pFT_Done_Face(face);
     return STATUS_SUCCESS;
 }
 
-static NTSTATUS get_design_glyph_metrics(void *args)
+static NTSTATUS get_design_glyph_metrics_unlocked(void *args)
 {
     struct get_design_glyph_metrics_params *params = args;
     FT_Face face = FaceFromObject(params->object);
@@ -504,7 +620,7 @@ static void embolden_glyph(FT_Glyph glyph, FLOAT emsize)
     embolden_glyph_outline(&outline_glyph->outline, emsize);
 }
 
-static NTSTATUS get_glyph_outline(void *args)
+static NTSTATUS get_glyph_outline_unlocked(void *args)
 {
     struct get_glyph_outline_params *params = args;
     FT_Face face = FaceFromObject(params->object);
@@ -545,7 +661,7 @@ static NTSTATUS get_glyph_outline(void *args)
     return STATUS_SUCCESS;
 }
 
-static NTSTATUS get_glyph_count(void *args)
+static NTSTATUS get_glyph_count_unlocked(void *args)
 {
     struct get_glyph_count_params *params = args;
     FT_Face face = FaceFromObject(params->object);
@@ -592,7 +708,7 @@ static BOOL get_glyph_transform(unsigned int simulations, const MATRIX_2X2 *m, F
     return TRUE;
 }
 
-static NTSTATUS get_glyph_bbox(void *args)
+static NTSTATUS get_glyph_bbox_unlocked(void *args)
 {
     struct get_glyph_bbox_params *params = args;
     FT_Face face = FaceFromObject(params->object);
@@ -733,7 +849,7 @@ static NTSTATUS freetype_get_aa_glyph_bitmap(struct get_glyph_bitmap_params *par
     return STATUS_SUCCESS;
 }
 
-static NTSTATUS get_glyph_bitmap(void *args)
+static NTSTATUS get_glyph_bitmap_unlocked(void *args)
 {
     struct get_glyph_bitmap_params *params = args;
     FT_Face face = FaceFromObject(params->object);
@@ -776,7 +892,7 @@ static NTSTATUS get_glyph_bitmap(void *args)
     return ret;
 }
 
-static NTSTATUS get_glyph_advance(void *args)
+static NTSTATUS get_glyph_advance_unlocked(void *args)
 {
     struct get_glyph_advance_params *params = args;
     FT_Face face = FaceFromObject(params->object);
@@ -799,6 +915,25 @@ static NTSTATUS get_glyph_advance(void *args)
     return STATUS_SUCCESS;
 }
 
+#define LOCKED_ENTRY(name) \
+    static NTSTATUS name(void *args) \
+    { \
+        NTSTATUS status; \
+        pthread_mutex_lock(&freetype_mutex); \
+        status = name##_unlocked(args); \
+        pthread_mutex_unlock(&freetype_mutex); \
+        return status; \
+    }
+
+LOCKED_ENTRY(create_font_object)
+LOCKED_ENTRY(release_font_object)
+LOCKED_ENTRY(get_design_glyph_metrics)
+LOCKED_ENTRY(get_glyph_outline)
+LOCKED_ENTRY(get_glyph_count)
+LOCKED_ENTRY(get_glyph_bbox)
+LOCKED_ENTRY(get_glyph_bitmap)
+LOCKED_ENTRY(get_glyph_advance)
+
 #else /* SONAME_LIBFREETYPE */
 
 static NTSTATUS process_attach(void *args)
-- 
