diff --git a/include/wine/mao_stats.h b/include/wine/mao_stats.h
new file mode 100644
index 0000000..abc9885
--- /dev/null
+++ b/include/wine/mao_stats.h
@@ -0,0 +1,59 @@
+/*
+ * Optional event log for profiling plugin hosts (not upstream).
+ * Set WINE_MAO_STATS to a Windows directory path; each module then appends
+ * "<tick> <tid> <event> <value> <return addresses...>" lines to
+ * <dir>\<module>-<pid>.log. Unset, an event costs one check.
+ * Addresses are raw; map them with /proc/<pid>/maps of the process.
+ */
+#ifndef __WINE_MAO_STATS_H
+#define __WINE_MAO_STATS_H
+
+#include <stdio.h>
+#include <string.h>
+#include <windef.h>
+#include <winbase.h>
+
+#ifndef MAO_STATS_LINKAGE
+#define MAO_STATS_LINKAGE static
+#endif
+
+MAO_STATS_LINKAGE void mao_stat(const char *what, unsigned int value)
+{
+    static HANDLE file;
+    void *frames[24];
+    char buf[1024];
+    DWORD written;
+    int len, i, n;
+
+    if (file == INVALID_HANDLE_VALUE)
+        return;
+    if (!file)
+    {
+        HANDLE h = INVALID_HANDLE_VALUE;
+        char dir[MAX_PATH], name[MAX_PATH], path[2 * MAX_PATH];
+        HMODULE module;
+
+        if (GetEnvironmentVariableA("WINE_MAO_STATS", dir, sizeof(dir))
+                && GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                (const char *)mao_stat, &module)
+                && GetModuleFileNameA(module, name, sizeof(name)))
+        {
+            const char *base = strrchr(name, '\\') ? strrchr(name, '\\') + 1 : name;
+            snprintf(path, sizeof(path), "%s\\%s-%lu.log", dir, base, GetCurrentProcessId());
+            h = CreateFileA(path, FILE_APPEND_DATA, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_ALWAYS, 0, NULL);
+        }
+        if (InterlockedCompareExchangePointer(&file, h, NULL) && h != INVALID_HANDLE_VALUE)
+            CloseHandle(h);
+        if (file == INVALID_HANDLE_VALUE)
+            return;
+    }
+
+    len = snprintf(buf, sizeof(buf), "%lu %lu %s %u", GetTickCount(), GetCurrentThreadId(), what, value);
+    n = RtlCaptureStackBackTrace(1, ARRAY_SIZE(frames), frames, NULL);
+    for (i = 0; i < n && len < (int)sizeof(buf) - 24; i++)
+        len += snprintf(buf + len, sizeof(buf) - len, " %p", frames[i]);
+    buf[len++] = '\n';
+    WriteFile(file, buf, len, &written, NULL);
+}
+
+#endif
diff --git a/libs/vkd3d/libs/vkd3d-shader/dxbc.c b/libs/vkd3d/libs/vkd3d-shader/dxbc.c
index 10222d8..4ba4737 100644
--- a/libs/vkd3d/libs/vkd3d-shader/dxbc.c
+++ b/libs/vkd3d/libs/vkd3d-shader/dxbc.c
@@ -22,10 +22,14 @@
 
 #define DXBC_CHECKSUM_SKIP_BYTE_COUNT 20
 
+void mao_stat(const char *what, unsigned int value);
+
 static void compute_dxbc_checksum(const void *dxbc, size_t size, uint32_t checksum[4])
 {
     const uint8_t *ptr = dxbc;
 
+    mao_stat("md5", size);
+
     VKD3D_ASSERT(size > DXBC_CHECKSUM_SKIP_BYTE_COUNT);
     ptr += DXBC_CHECKSUM_SKIP_BYTE_COUNT;
     size -= DXBC_CHECKSUM_SKIP_BYTE_COUNT;
