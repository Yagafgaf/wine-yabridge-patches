+    D3D11_BUFFER_DESC buffer_desc;
+    struct d2d_factory *factory;
+    unsigned int i;
+    HRESULT hr;
+
     static const D3D_FEATURE_LEVEL feature_levels = D3D_FEATURE_LEVEL_10_0;
 
     mao_stat("d2d_ctx", ops ? 1 : 0);
@@ -4289,28 +4417,21 @@ static HRESULT d2d_device_context_init(struct d2d_device_context *render_target,
         goto err;
     }
 
