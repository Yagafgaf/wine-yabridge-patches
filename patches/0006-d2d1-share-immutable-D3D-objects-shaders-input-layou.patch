+    render_target->vb_stride = sizeof(*d2d_quad);
+    ID3D11RasterizerState_AddRef(render_target->rs = device->shared_rs);
 
     buffer_desc.ByteWidth = sizeof(struct d2d_vs_cb);
     buffer_desc.Usage = D3D11_USAGE_DYNAMIC;
