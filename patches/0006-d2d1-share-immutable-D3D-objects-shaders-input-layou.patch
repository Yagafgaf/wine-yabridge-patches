From 64c808c384f98550531445a2df5c9e8a16e2c807 Mon Sep 17 00:00:00 2001
From: Yagafgaf <Yagafgaf@users.noreply.github.com>
Date: Thu, 29 Oct 2026 16:12:04 +0300
Subject: [PATCH 06/10] d2d1: share immutable D3D objects (shaders, input
 layouts, buffers) among a device's contexts

---
 dlls/d2d1/d2d1_private.h |  11 ++
 dlls/d2d1/device.c       | 246 +++++++++++++++++++++++++--------------
 2 files changed, 168 insertions(+), 89 deletions(-)

diff --git a/dlls/d2d1/d2d1_private.h b/dlls/d2d1/d2d1_private.h
index 2f66873..5311d5b 100644
--- a/dlls/d2d1/d2d1_private.h
+++ b/dlls/d2d1/d2d1_private.h
@@ -683,6 +683,17 @@ struct d2d_device
     ID3D10Blob *precompiled_shape_vs[D2D_SHAPE_TYPE_COUNT];
     ID3D10Blob *precompiled_shape_ps;
 
+    /* Immutable D3D objects, created on first use and shared by all device
+     * contexts of this device. Editors can create dozens of bitmap render
+     * targets, and creating shaders for each was most of their cost. */
+    SRWLOCK shared_lock;
+    bool shared_ready;
+    struct d2d_shape_resources shared_shape_resources[D2D_SHAPE_TYPE_COUNT];
+    ID3D11PixelShader *shared_ps;
+    ID3D11Buffer *shared_ib;
+    ID3D11Buffer *shared_vb;
+    ID3D11RasterizerState *shared_rs;
+
     struct d2d_indexed_objects shaders;
 };
 
diff --git a/dlls/d2d1/device.c b/dlls/d2d1/device.c
index d54cc78..183ed13 100644
--- a/dlls/d2d1/device.c
+++ b/dlls/d2d1/device.c
@@ -4230,30 +4230,158 @@ shape_info[] =
      "curve",                       shape_vs_code_curve,          sizeof(shape_vs_code_curve) - 1},
 };
 
-static HRESULT d2d_device_context_init(struct d2d_device_context *render_target,
-        struct d2d_device *device, IUnknown *outer_unknown, const struct d2d_device_context_ops *ops)
+static const struct
+{
+    float x, y;
+}
+d2d_quad[] =
+{
+    {-1.0f,  1.0f},
+    {-1.0f, -1.0f},
+    { 1.0f,  1.0f},
+    { 1.0f, -1.0f},
+};
+static const UINT16 d2d_quad_indices[] = {0, 1, 2, 2, 1, 3};
+
+static void d2d_device_release_shared_resources(struct d2d_device *device)
+{
+    for (unsigned int i = 0; i < D2D_SHAPE_TYPE_COUNT; ++i)
+    {
+        if (device->shared_shape_resources[i].il)
+            ID3D11InputLayout_Release(device->shared_shape_resources[i].il);
+        if (device->shared_shape_resources[i].vs)
+            ID3D11VertexShader_Release(device->shared_shape_resources[i].vs);
+    }
+    if (device->shared_ps)
+        ID3D11PixelShader_Release(device->shared_ps);
+    if (device->shared_ib)
+        ID3D11Buffer_Release(device->shared_ib);
+    if (device->shared_vb)
+        ID3D11Buffer_Release(device->shared_vb);
+    if (device->shared_rs)
+        ID3D11RasterizerState_Release(device->shared_rs);
+    memset(device->shared_shape_resources, 0, sizeof(device->shared_shape_resources));
+    device->shared_ps = NULL;
+    device->shared_ib = NULL;
+    device->shared_vb = NULL;
+    device->shared_rs = NULL;
+}
+
+static HRESULT d2d_device_create_shared_resources(struct d2d_device *device, ID3D11Device1 *d3d_device)
 {
     D3D11_SUBRESOURCE_DATA buffer_data;
-    IDWriteFactory *dwrite_factory;
     D3D11_RASTERIZER_DESC rs_desc;
     D3D11_BUFFER_DESC buffer_desc;
-    struct d2d_factory *factory;
     ID3D10Blob *precompiled;
-    unsigned int i;
     HRESULT hr;
 
-    static const struct
+    for (unsigned int i = 0; i < ARRAY_SIZE(shape_info); ++i)
     {
-        float x, y;
+        const struct shape_info *si = &shape_info[i];
+        struct d2d_shape_resources *res = &device->shared_shape_resources[si->shape_type];
+
+        assert(device->precompiled_shape_vs[i]);
+        precompiled = device->precompiled_shape_vs[i];
+        if (FAILED(hr = ID3D11Device1_CreateInputLayout(d3d_device, si->il_desc, si->il_element_count,
+                ID3D10Blob_GetBufferPointer(precompiled), ID3D10Blob_GetBufferSize(precompiled), &res->il)))
+        {
+            WARN("Failed to create input layout for shape type %#x, hr %#lx.\n", si->shape_type, hr);
+            return hr;
+        }
+
+        if (FAILED(hr = ID3D11Device1_CreateVertexShader(d3d_device,
+                ID3D10Blob_GetBufferPointer(precompiled), ID3D10Blob_GetBufferSize(precompiled),
+                NULL, &res->vs)))
+        {
+            WARN("Failed to create vertex shader for shape type %#x, hr %#lx.\n", si->shape_type, hr);
+            return hr;
+        }
     }
-    quad[] =
+
+    assert(device->precompiled_shape_ps);
+    precompiled = device->precompiled_shape_ps;
+    if (FAILED(hr = ID3D11Device1_CreatePixelShader(d3d_device,
+            ID3D10Blob_GetBufferPointer(precompiled), ID3D10Blob_GetBufferSize(precompiled),
+            NULL, &device->shared_ps)))
+    {
+        WARN("Failed to create pixel shader, hr %#lx.\n", hr);
+        return hr;
+    }
+
+    buffer_desc.ByteWidth = sizeof(d2d_quad_indices);
+    buffer_desc.Usage = D3D11_USAGE_DEFAULT;
+    buffer_desc.BindFlags = D3D11_BIND_INDEX_BUFFER;
+    buffer_desc.CPUAccessFlags = 0;
+    buffer_desc.MiscFlags = 0;
+    buffer_desc.StructureByteStride = 0;
+
+    buffer_data.pSysMem = d2d_quad_indices;
+    buffer_data.SysMemPitch = 0;
+    buffer_data.SysMemSlicePitch = 0;
+
+    if (FAILED(hr = ID3D11Device1_CreateBuffer(d3d_device, &buffer_desc, &buffer_data, &device->shared_ib)))
+    {
+        WARN("Failed to create clear index buffer, hr %#lx.\n", hr);
+        return hr;
+    }
+
+    buffer_desc.ByteWidth = sizeof(d2d_quad);
+    buffer_desc.BindFlags = D3D11_BIND_VERTEX_BUFFER;
+    buffer_data.pSysMem = d2d_quad;
+
+    if (FAILED(hr = ID3D11Device1_CreateBuffer(d3d_device, &buffer_desc, &buffer_data, &device->shared_vb)))
+    {
+        WARN("Failed to create clear vertex buffer, hr %#lx.\n", hr);
+        return hr;
+    }
+
+    rs_desc.FillMode = D3D11_FILL_SOLID;
+    rs_desc.CullMode = D3D11_CULL_NONE;
+    rs_desc.FrontCounterClockwise = FALSE;
+    rs_desc.DepthBias = 0;
+    rs_desc.DepthBiasClamp = 0.0f;
+    rs_desc.SlopeScaledDepthBias = 0.0f;
+    rs_desc.DepthClipEnable = TRUE;
+    rs_desc.ScissorEnable = TRUE;
+    rs_desc.MultisampleEnable = FALSE;
+    rs_desc.AntialiasedLineEnable = FALSE;
+    if (FAILED(hr = ID3D11Device1_CreateRasterizerState(d3d_device, &rs_desc, &device->shared_rs)))
+    {
+        WARN("Failed to create clear rasteriser state, hr %#lx.\n", hr);
+        return hr;
+    }
+
+    return S_OK;
+}
+
+/* All device contexts of a device use the same D3D device (queried from
+ * device->dxgi_device), so these objects are valid for each of them. */
+static HRESULT d2d_device_init_shared_resources(struct d2d_device *device, ID3D11Device1 *d3d_device)
+{
+    HRESULT hr = S_OK;
+
+    AcquireSRWLockExclusive(&device->shared_lock);
+    if (!device->shared_ready)
     {
-        {-1.0f,  1.0f},
-        {-1.0f, -1.0f},
-        { 1.0f,  1.0f},
-        { 1.0f, -1.0f},
-    };
-    static const UINT16 indices[] = {0, 1, 2, 2, 1, 3};
+        if (SUCCEEDED(hr = d2d_device_create_shared_resources(device, d3d_device)))
+            device->shared_ready = true;
+        else
+            d2d_device_release_shared_resources(device);
+    }
+    ReleaseSRWLockExclusive(&device->shared_lock);
+
+    return hr;
+}
+
