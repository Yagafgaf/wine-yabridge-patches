From 95587d8723383eafe765b4daca51e7680332b7dd Mon Sep 17 00:00:00 2001
From: Yagafgaf <Yagafgaf@users.noreply.github.com>
Date: Thu, 29 Oct 2026 15:43:50 +0300
Subject: [PATCH 03/10] dwrite: cache FreeType size objects per face instead of
 one per glyph call

---
 dlls/dwrite/freetype.c | 77 ++++++++++++++++++++++++++++++++++++++----
 1 file changed, 71 insertions(+), 6 deletions(-)

diff --git a/dlls/dwrite/freetype.c b/dlls/dwrite/freetype.c
index 13d9a07..10d5681 100644
--- a/dlls/dwrite/freetype.c
+++ b/dlls/dwrite/freetype.c
@@ -26,6 +26,7 @@
 
 #include <sys/types.h>
 #include <dlfcn.h>
+#include <stdlib.h>
 
 #ifdef HAVE_FT2BUILD_H
 #include <ft2build.h>
@@ -89,10 +90,55 @@ MAKE_FUNCPTR(FT_Set_Pixel_Sizes);
 
 #define FaceFromObject(o) ((FT_Face)(ULONG_PTR)(o))
 
+/* Creating a size object for every glyph request is expensive: hinting state
+ * (TrueType 'prep' program, autohinter metrics) is set up again each time.
+ * Keep a few recently used sizes per face instead; FT_Done_Face() frees them.
+ * Callers are serialized by the font face lock on the PE side. */
+#define FACE_SIZE_CACHE_COUNT 4
+
+struct face_size_cache
+{
+    struct
+    {
+        FT_UInt emsize;
+        FT_Size size;
+    } entries[FACE_SIZE_CACHE_COUNT];
+    unsigned int next;
+};
+
+static void face_size_cache_finalizer(void *object)
+{
+    FT_Face face = object;
+    free(face->generic.data);
+}
+
 static FT_Size freetype_set_face_size(FT_Face face, FT_UInt emsize)
 {
+    struct face_size_cache *cache = face->generic.data;
+    unsigned int i;
     FT_Size size;
 
+    if (!cache && face->generic.finalizer != face_size_cache_finalizer)
+    {
+        if ((cache = calloc(1, sizeof(*cache))))
+        {
+            face->generic.data = cache;
+            face->generic.finalizer = face_size_cache_finalizer;
+        }
+    }
+
+    if (cache)
+    {
+        for (i = 0; i < FACE_SIZE_CACHE_COUNT; ++i)
+        {
+            if (cache->entries[i].size && cache->entries[i].emsize == emsize)
+            {
+                pFT_Activate_Size(cache->entries[i].size);
+                return cache->entries[i].size;
+            }
+        }
+    }
+
     if (pFT_New_Size(face, &size)) return NULL;
 
     pFT_Activate_Size(size);
@@ -103,9 +149,28 @@ static FT_Size freetype_set_face_size(FT_Face face, FT_UInt emsize)
         return NULL;
     }
 
+    if (cache)
+    {
+        i = cache->next;
+        cache->next = (i + 1) % FACE_SIZE_CACHE_COUNT;
+        if (cache->entries[i].size)
+            pFT_Done_Size(cache->entries[i].size);
+        cache->entries[i].emsize = emsize;
+        cache->entries[i].size = size;
+    }
+
     return size;
 }
 
+static void freetype_release_face_size(FT_Face face, FT_Size size)
+{
+    struct face_size_cache *cache = face->generic.data;
+
+    /* Only sizes that did not make it into the cache are freed here. */
+    if (!cache)
+        pFT_Done_Size(size);
+}
+
 static BOOL freetype_glyph_has_contours(FT_Face face)
 {
     return face->glyph->format == FT_GLYPH_FORMAT_OUTLINE && face->glyph->outline.n_contours;
@@ -233,7 +298,7 @@ static NTSTATUS get_design_glyph_metrics(void *args)
         }
     }
 
-    pFT_Done_Size(size);
+    freetype_release_face_size(face, size);
 
     return STATUS_SUCCESS;
 }
@@ -475,7 +540,7 @@ static NTSTATUS get_glyph_outline(void *args)
         }
     }
 
-    pFT_Done_Size(size);
+    freetype_release_face_size(face, size);
 
     return STATUS_SUCCESS;
 }
@@ -547,7 +612,7 @@ static NTSTATUS get_glyph_bbox(void *args)
     if (pFT_Load_Glyph(face, params->glyph, needs_transform ? FT_LOAD_NO_BITMAP : 0))
     {
         WARN("Failed to load glyph %u.\n", params->glyph);
-        pFT_Done_Size(size);
+        freetype_release_face_size(face, size);
         return STATUS_UNSUCCESSFUL;
     }
 
@@ -563,7 +628,7 @@ static NTSTATUS get_glyph_bbox(void *args)
 
     pFT_Glyph_Get_CBox(glyph, FT_GLYPH_BBOX_PIXELS, &bbox);
     pFT_Done_Glyph(glyph);
-    pFT_Done_Size(size);
+    freetype_release_face_size(face, size);
 
     /* flip Y axis */
     SetRect(params->bbox, bbox.xMin, -bbox.yMax, bbox.xMax, -bbox.yMin);
@@ -706,7 +771,7 @@ static NTSTATUS get_glyph_bitmap(void *args)
         pFT_Done_Glyph(glyph);
     }
 
-    pFT_Done_Size(size);
+    freetype_release_face_size(face, size);
 
     return ret;
 }
@@ -729,7 +794,7 @@ static NTSTATUS get_glyph_advance(void *args)
         *params->has_contours = freetype_glyph_has_contours(face);
     }
 
-    pFT_Done_Size(size);
+    freetype_release_face_size(face, size);
 
     return STATUS_SUCCESS;
 }
-- 
